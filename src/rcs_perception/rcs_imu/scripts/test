#!/usr/bin/env python3
"""离线转换与 launch 测试，无需 IMU。"""
import subprocess
from pathlib import Path
from ament_index_python.packages import get_package_prefix, get_package_share_directory

if __name__ == '__main__':
    executable = Path(get_package_prefix('rcs_imu')) / 'lib/rcs_imu/rcs_imu_conversion_test'
    result = subprocess.run([str(executable)]).returncode
    if result:
        raise SystemExit(result)
    import pytest
    tests = Path(get_package_share_directory('rcs_imu')) / 'test'
    raise SystemExit(pytest.main([str(tests), '-q', '-p', 'no:cacheprovider']))
