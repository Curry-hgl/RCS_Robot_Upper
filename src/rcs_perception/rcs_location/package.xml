  <exec_depend>launch_ros</exec_depend><exec_depend>python3-yaml</exec_depend><exec_depend>rcs_imu</exec_depend>
  <test_depend>rclpy</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
