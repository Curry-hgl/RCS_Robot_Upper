#!/usr/bin/env python3
"""运行离线轨迹与模拟 ROS 输入测试，无需设备。"""
import subprocess
import sys
from pathlib import Path
from ament_index_python.packages import get_package_prefix, get_package_share_directory

if __name__ == '__main__':
    binary = Path(get_package_prefix('rcs_location')) / 'lib/rcs_location/rcs_location_algorithm_test'
    result = subprocess.run([str(binary)]).returncode
    if result:
        raise SystemExit(result)
    test = Path(get_package_share_directory('rcs_location')) / 'test/algorithm/test_ros.py'
    raise SystemExit(subprocess.run([sys.executable, str(test)]).returncode)
