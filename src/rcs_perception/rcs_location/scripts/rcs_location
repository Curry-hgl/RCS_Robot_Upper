#!/usr/bin/env python3
"""读取配置并启动定位 launch。"""
import argparse
from pathlib import Path
from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription, LaunchService
from launch.actions import IncludeLaunchDescription
from launch.launch_description_sources import PythonLaunchDescriptionSource


def main():
    parser = argparse.ArgumentParser(description='启动 IMU 定位')
    parser.add_argument('mode', nargs='?', choices=['algorithm'], help='只启动算法；默认连同 IMU 驱动启动')
    parser.add_argument('--config', help='当前入口的 YAML 配置')
    args = parser.parse_args()
    share = Path(get_package_share_directory('rcs_location'))
    name = 'rcs_location_algorithm' if args.mode else 'rcs_location'
    config = Path(args.config).expanduser().resolve() if args.config else share / f'config/{name}.yaml'
    if not config.is_file():
        parser.error(f'配置不存在：{config}')
    key = 'algorithm_config' if args.mode else 'config'
    service = LaunchService()
    service.include_launch_description(LaunchDescription([
        IncludeLaunchDescription(PythonLaunchDescriptionSource(str(share / f'launch/{name}.launch.py')),
                                 launch_arguments={key: str(config)}.items())]))
    return service.run()


if __name__ == '__main__':
    raise SystemExit(main())
